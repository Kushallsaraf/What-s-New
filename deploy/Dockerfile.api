# syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/pipeline/src

COPY pipeline/pyproject.toml pipeline/README.md /app/pipeline/
COPY pipeline/src /app/pipeline/src

RUN pip install --no-cache-dir -e "/app/pipeline[api,data,llm]"

EXPOSE 8080
CMD ["uvicorn", "whats_new.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
