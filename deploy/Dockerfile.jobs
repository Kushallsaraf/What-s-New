# syntax=docker/dockerfile:1
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/pipeline/src

COPY pipeline/pyproject.toml pipeline/README.md /app/pipeline/
COPY pipeline/src /app/pipeline/src
COPY deploy/schedule.toml /app/deploy/schedule.toml

RUN pip install --no-cache-dir -e "/app/pipeline[data,llm,kronos]"

# Cloud Run Job args override this; default prints usage.
ENTRYPOINT ["python", "-m", "whats_new.jobs"]
CMD ["list"]
