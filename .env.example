# What's New — local development environment
# Copy to .env and fill in values. Never commit .env.

# --- Database (hosted Supabase) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Market data (Alpaca Basic / free paper) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

# --- News ---
FINNHUB_API_KEY=
SEC_USER_AGENT="What's New your-email@example.com"
WN_NEWS_SOURCES=rss,sec_edgar,finnhub
# Initial SEC research set only; this is not a product-wide ticker cap.
WN_SEC_TICKERS=AAPL,MSFT,NVDA,AMZN,META,JPM,XOM,JNJ,SOFI,HIMS,IONQ,RKLB,RXST,ACMR,UPWK,RY,TD,SHOP,ENB,CNQ,CP,CNI,BMO,LSPD,BB,BLDP,SAND,ORLA,EQX,AG

# --- Official macro data ---
FRED_API_KEY=
EIA_API_KEY=
# Optional: BLS works without a registration key at MVP volume.
BLS_API_KEY=
WN_MACRO_SOURCES=treasury,bls,fred,eia
FRED_SERIES=FEDFUNDS,GDPC1,INDPRO,RSAFS
BLS_SERIES=CUSR0000SA0,CES0000000001,LNS14000000
EIA_SERIES=WCESTUS1,WGTSTUS1,WCRFPUS2,NW2_EPG0_SWO_R48_BCF

# --- LLM ---
WN_LLM_PROVIDER=openai
LLM_API_KEY=
# OPENAI_API_KEY=   # alternative to LLM_API_KEY
LLM_MODEL_ANALYSIS=gpt-4o-mini
LLM_MODEL_REPORTS=gpt-4o
LLM_BUDGET_USD_PER_RUN=1.0

# --- Signal weights (Kronos stays 0 until retention gate passes) ---
SIGNAL_WEIGHT_NEWS=0.45
SIGNAL_WEIGHT_KRONOS=0.0
SIGNAL_WEIGHT_MARKET=0.55

# --- Capability ports (local defaults; flip to adopt cloud) ---
WN_SECRETS=env
WN_BLOBS=local
WN_QUEUE=inline
WN_PUSH=console
WN_ANALYTICS=noop
WN_TELEMETRY=stdout-json
WN_CACHE=postgres
WN_FORECASTER=local-cpu
WN_MAILER=console

# --- Paths / replay ---
# FIXTURES_DIR=./fixtures
# OUTPUTS_DIR=./outputs
WN_REPLAY=0

# --- Mobile (Expo) ---
# EXPO_PUBLIC_RESEARCH_API_URL=http://127.0.0.1:8000
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Deferred cloud (set when provisioning; see docs/cloud-readiness.md) ---
# GCP_PROJECT=
# GCS_BUCKET=
# CLOUD_TASKS_QUEUE=
# EXPO_ACCESS_TOKEN=
# POSTHOG_API_KEY=
# SENTRY_DSN=
# REDIS_URL=
# RESEND_API_KEY=
